# TripZ — environment variables.
#
# Copy to .env.local and fill in. This file previously documented a Supabase project
# that no longer exists and listed none of the variables the app actually reads.

# --- Database ---------------------------------------------------------------
# Neon Postgres. DATABASE_URL is the POOLED endpoint (host contains "-pooler") and is
# what the app runs on: each serverless invocation opens its own connection and the
# direct endpoint exhausts quickly.
DATABASE_URL=
# The DIRECT endpoint. Used only by scripts that run DDL — schema changes must not go
# through a transaction pooler, which can hand successive statements to different
# backends mid-migration.
DATABASE_URL_UNPOOLED=

# --- Auth -------------------------------------------------------------------
# Better Auth. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# There is no fallback and no fail-open path: without this, nobody signs in.
BETTER_AUTH_SECRET=
# Origin the auth endpoints are served from. Leave blank to infer it from the
# request, which is what preview deployments need.
BETTER_AUTH_URL=http://localhost:3000

# --- Storage ----------------------------------------------------------------
# Vercel Blob. Uploaded tickets live here; booking_documents.file_url holds the URL.
BLOB_READ_WRITE_TOKEN=

# --- Optional: automatic ticket extraction -----------------------------------
# Off unless TRIPZ_AI_EXTRACTION is exactly "on" AND a key is present. Otherwise
# uploaded tickets are stored and queued for manual entry.
TRIPZ_AI_EXTRACTION=off
ANTHROPIC_API_KEY=
TRIPZ_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Optional: scripts -------------------------------------------------------
# scripts/seed-from-export.mjs and tests/margin.test.mjs read the real workbook
# export when this is set.
TRIPZ_REAL_DATA=
# scripts/k6-admin-load.js signs in with these. ADMIN_USER is an email or a username.
ADMIN_USER=
ADMIN_PASSWORD=
